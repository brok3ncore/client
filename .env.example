# Публичный ключ виджета Yandex SmartCaptcha
REACT_APP_YANDEX_CAPTCHA_SITE_KEY=

# Секретный ключ SmartCaptcha для serverless-функции /api/verify-captcha
YANDEX_CAPTCHA_SECRET_KEY=

# Бесплатная база Supabase. Если не указать — приложение работает в demo localStorage-режиме.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_SUPABASE_TABLE=music_school_data

# Необязательно: общий workspace одной школы. Должен начинаться с school_.
# Если оставить пустым, у каждого браузера будет свой school_<uuid>.
REACT_APP_SCHOOL_WORKSPACE_ID=
